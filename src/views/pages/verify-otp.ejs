<!doctype html>
<html lang="ru">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    .otp-input {
      letter-spacing: 8px;
      font-size: 28px;
      text-align: center;
      font-weight: 700;
    }
    .otp-hint {
      text-align: center;
      color: #888;
      font-size: 13px;
      margin-top: 8px;
    }
  </style>
</head>

<body>
  <%- include('../partials/header') %>
  <main class="container auth">
    <h1 class="page-title">Подтверждение входа</h1>
    <p class="muted" style="text-align: center; margin-bottom: 20px;">
      Мы отправили 6-значный код на ваш email. Введите его ниже.
    </p>

    <% if (error) { %>
      <div class="alert alert--error"><%= error %></div>
    <% } %>

    <form class="form" method="POST" action="/verify-otp">
      <label class="label">Код подтверждения</label>
      <input class="input otp-input" name="code" type="text" inputmode="numeric"
             maxlength="6" placeholder="000000" autocomplete="one-time-code" required>
      <p class="otp-hint">Код действителен 10 минут</p>
      <button class="btn btn--primary" type="submit" style="margin-top: 12px;">Подтвердить</button>
    </form>

    <p class="muted" style="margin-top: 16px; text-align: center;">
      <a href="/login">Вернуться к входу</a>
    </p>
  </main>
  <%- include('../partials/footer') %>
</body>

</html>
