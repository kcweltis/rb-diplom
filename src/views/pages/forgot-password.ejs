<!doctype html>
<html lang="ru">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  <%- include('../partials/header') %>
  <main class="container auth">
    <h1 class="page-title">Восстановление пароля</h1>

    <% if (sent) { %>
      <div class="alert alert--success" style="background:#d4edda; color:#155724; padding:12px 16px; border-radius:8px; margin-bottom:20px;">
        Если аккаунт с такими данными существует — мы отправили код на привязанный email.
      </div>
      <p class="muted" style="text-align: center;">
        <a href="/reset-password">Ввести код и задать новый пароль &rarr;</a>
      </p>
    <% } else { %>
      <p class="muted" style="margin-bottom: 20px; text-align: center;">
        Введите email или телефон, привязанный к аккаунту. Мы отправим код для сброса пароля.
      </p>

      <% if (error) { %>
        <div class="alert alert--error"><%= error %></div>
      <% } %>

      <form class="form" method="POST" action="/forgot-password">
        <label class="label">Email или телефон</label>
        <input class="input" name="identifier" type="text" placeholder="example@mail.ru или +7..." required>
        <button class="btn btn--primary" type="submit">Отправить код</button>
      </form>
    <% } %>

    <p class="muted" style="margin-top: 16px; text-align: center;">
      <a href="/login">Вернуться к входу</a>
    </p>
  </main>
  <%- include('../partials/footer') %>
</body>

</html>
