<!doctype html>
<html lang="ru">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    <%= title %>
  </title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Philosopher:wght@400;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  <%- include('../partials/header', { isHome: true }) %>
    <main class="page page-home">

      <section class="hero-slider-section">
        <div class="hero-slider" id="heroSlider">
          <% if (typeof banners !=='undefined' && banners.length> 0) { %>
            <% banners.forEach((banner, index)=> { %>
              <div class="slide <%= index === 0 ? 'active' : '' %>"
                style="background-image: url('<%= banner.image_url %>')"></div>
              <% }) %>
                <% } else { %>
                  <div class="slide active" style="background-image: url('/img/banner1.jpg')"></div>
                  <% } %>
        </div>

        <div class="hero-content container">
          <h1 class="hero-title">
            Готовим<br>
            для Вас с<br>
            <span class="text-brand">душой</span>!
          </h1>
          <div class="hero-actions">
            <a href="/delivery" class="btn btn--outline"
              style="background: rgba(255,255,255,0.9); color: #333; border-color: transparent;">ДОСТАВКА</a>
            <a href="/menu" class="btn btn--primary">МЕНЮ</a>
          </div>
        </div>
      </section>

      <section class="section container">
        <div class="section__head">
          <h2 class="section__title">Новинки</h2>
        </div>

        <div class="cards">
          <% if (featured && featured.length) { %>
            <% featured.forEach(p=> { %>
              <article class="card">
                <img class="card__img" src="<%= p.image_url || '/img/products/placeholder.png' %>" alt="<%= p.name %>">
                <div class="card__body">
                  <h3 class="card__title">
                    <%= p.name %>
                  </h3>
                  <div class="card__bottom">
                    <span class="card__price">
                      <%= Number(p.price).toFixed(0) %> руб.
                    </span>
                    <a class="btn btn--pill" href="/menu?openProductId=<%= p.id %>">В корзину</a>
                  </div>
                </div>
              </article>
              <% }) %>
                <% } else { %>
                  <p class="muted">Новинок нету в наличии</p>
                  <% } %>
        </div>

        <div class="section__cta">
          <a class="btn btn--primary" href="/menu">Перейти в меню</a>
        </div>
      </section>

      <section class="delivery-block" id="deliverySection">
        <div class="container delivery-block__inner">
          <div class="delivery-block__text" id="deliveryText">
            <h2 class="section__title">Собственная доставка</h2>
            <p class="muted">Мы доставляем заказы собственной курьерской службой — без посредников и дополнительных
              комиссий.</p>
          </div>
          <img class="delivery-block__icon" id="deliveryScooter" src="/img/icons/courier.png" alt="Курьер">
        </div>
      </section>

      <section class="section container" id="stepsSection">
        <h2 class="section__title section__title--center">Как сделать заказ</h2>

        <div class="route-wrapper">
          <svg class="route-svg" viewBox="0 0 400 600" preserveAspectRatio="xMidYMid meet"
            xmlns="http://www.w3.org/2000/svg">
            <defs>
              <mask id="draw-mask">
                <path id="maskPath"
                  d="M 120 80 C 250 80, 280 150, 280 230 C 280 310, 120 300, 120 380 C 120 460, 280 450, 280 530"
                  fill="none" stroke="white" stroke-width="10" stroke-linecap="round" />
              </mask>
            </defs>
            <path d="M 120 80 C 250 80, 280 150, 280 230 C 280 310, 120 300, 120 380 C 120 460, 280 450, 280 530"
              fill="none" stroke="#7A1818" stroke-width="2" stroke-dasharray="10 10" mask="url(#draw-mask)" />
          </svg>

          <div class="route-step step-1">
            <div class="route-step__icon">
              <img src="/img/icons/step1.svg" alt="Выберите блюда">
            </div>
            <div class="route-step__text">Выберите<br>блюда</div>
          </div>

          <div class="route-step step-2">
            <div class="route-step__icon">
              <img src="/img/icons/step2.svg" alt="Оформите заказ">
            </div>
            <div class="route-step__text">Оформите<br>заказ</div>
          </div>

          <div class="route-step step-3">
            <div class="route-step__icon">
              <img src="/img/icons/step3.svg" alt="Мы приготовим">
            </div>
            <div class="route-step__text">Мы<br>приготовим</div>
          </div>

          <div class="route-step step-4">
            <div class="route-step__icon">
              <img src="/img/icons/step4.svg" alt="Курьер доставит">
            </div>
            <div class="route-step__text">Курьер<br>доставит</div>
          </div>
        </div>
      </section>

      <section class="worktime">
        РАБОТАЕМ С ДУШОЙ КАЖДЫЙ ДЕНЬ С 10.00 ДО 22.00
      </section>
    </main>
    <%- include('../partials/chat-widget') %>
      <%- include('../partials/footer') %>


        <script>
          document.addEventListener('DOMContentLoaded', () => {

            // ==========================================
            // 1. АНИМАЦИЯ СЛАЙДЕРА
            // ==========================================
            const slides = document.querySelectorAll('.hero-slider .slide');
            if (slides.length > 0) {
              let currentSlide = 0;
              const slideInterval = 4000;

              setInterval(() => {
                slides[currentSlide].classList.remove('active');
                currentSlide = (currentSlide + 1) % slides.length;
                slides[currentSlide].classList.add('active');
              }, slideInterval);
            }

            // ==========================================
            // 2. АНИМАЦИЯ КУРЬЕРА (ОДИН РАЗ ПРИ ПОЯВЛЕНИИ)
            // ==========================================
            const observerOptions = {
              threshold: 0.3 // Анимация начнется, когда 30% блока покажется на экране
            };

            const scrollObserver = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-animated'); // Добавляем класс, запускающий CSS
                  scrollObserver.unobserve(entry.target);    // Отписываемся, чтобы анимация была 1 раз
                }
              });
            }, observerOptions);

            const deliverySec = document.getElementById('deliverySection');
            if (deliverySec) scrollObserver.observe(deliverySec);

            // ==========================================
            // 3. АНИМАЦИЯ ШАГОВ ЗАКАЗА (ПРИВЯЗКА К СКРОЛЛУ)
            // ==========================================
            const section = document.getElementById('stepsSection');
            const maskPath = document.getElementById('maskPath');
            const steps = document.querySelectorAll('.route-step');

            if (section && maskPath) {
              // ИСПРАВЛЕНИЕ 1: Если браузер не может посчитать скрытую линию и выдает 0, 
              // мы ставим жесткое значение 1000 (этого с запасом хватит для нашего SVG)
              let pathLength = maskPath.getTotalLength();
              if (!pathLength || pathLength === 0) {
                pathLength = 1000;
              }

              // ИСПРАВЛЕНИЕ 2: Используем setAttribute вместо style для работы внутри <defs>
              maskPath.setAttribute('stroke-dasharray', pathLength);
              maskPath.setAttribute('stroke-dashoffset', pathLength);

              // Слушаем скролл
              window.addEventListener('scroll', () => {
                const rect = section.getBoundingClientRect();
                const windowHeight = window.innerHeight;

                // Определяем, когда начинать и заканчивать анимацию
                const start = windowHeight * 0.8;
                const end = windowHeight * 0.1;

                // Вычисляем прогресс от 0 до 1
                let progress = (start - rect.top) / (start - end);
                progress = Math.max(0, Math.min(1, progress));

                // Рисуем/стираем линию (через setAttribute)
                const currentOffset = pathLength - (pathLength * progress);
                maskPath.setAttribute('stroke-dashoffset', currentOffset);

                // Показываем/прячем шаги
                steps.forEach((step, index) => {
                  const threshold = (index + 1) * 0.22;
                  if (progress >= threshold) {
                    step.classList.add('is-visible');
                  } else {
                    step.classList.remove('is-visible');
                  }
                });
              });

              // Вызываем один раз при загрузке
              window.dispatchEvent(new Event('scroll'));
            }

          }); 
        </script>
</body>

</html>