<!doctype html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
        <%= title %>
    </title>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Philosopher:wght@400;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css" />
    <style>
        .legal-page {
            padding: 60px 0 80px;
            background: #fcfaf8;
            min-height: 80vh;
        }

        .legal-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .page-title {
            font-family: 'Philosopher', sans-serif;
            font-size: 36px;
            margin-bottom: 40px;
            text-align: center;
            color: #111;
            text-transform: uppercase;
        }

        /* Сетка документов */
        .docs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 50px;
        }

        .doc-card {
            background: #fff;
            border: 1px solid #eaeaea;
            border-radius: 16px;
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            text-decoration: none;
            color: #333;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        }

        .doc-card:hover {
            border-color: #E30613;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(227, 6, 19, 0.1);
        }

        .doc-icon {
            font-size: 28px;
            background: #fff4f4;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
        }

        .doc-title {
            font-weight: 600;
            font-size: 15px;
            line-height: 1.4;
        }

        /* Карточка ООО */
        .company-card {
            background: #fff;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            margin-bottom: 40px;
            border-left: 5px solid #E30613;
        }

        .company-card h2 {
            font-family: 'Philosopher', sans-serif;
            font-size: 24px;
            margin-bottom: 25px;
            color: #111;
        }

        .company-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            font-size: 14px;
            line-height: 1.6;
            color: #444;
        }

        .company-details b {
            color: #111;
            font-weight: 600;
        }

        .company-details .col ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .company-details .col ul li {
            margin-bottom: 8px;
            border-bottom: 1px dashed #eee;
            padding-bottom: 8px;
        }

        .company-details .col ul li:last-child {
            border-bottom: none;
        }

        /* Сетка ИП */
        .ip-section-title {
            font-family: 'Philosopher', sans-serif;
            font-size: 24px;
            margin-bottom: 20px;
            color: #111;
        }

        .ip-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 15px;
        }

        .ip-card {
            background: #fff;
            border: 1px solid #eee;
            padding: 20px;
            border-radius: 16px;
            transition: 0.3s;
        }

        .ip-card:hover {
            border-color: #ddd;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        }

        .ip-card h3 {
            font-size: 14px;
            margin: 0 0 10px 0;
            color: #111;
            font-weight: 700;
            line-height: 1.4;
        }

        .ip-card p {
            font-size: 13px;
            color: #666;
            margin: 0 0 4px 0;
            font-family: 'Courier New', Courier, monospace;
            font-weight: 600;
        }

        .ip-card p span {
            color: #999;
            font-family: 'Montserrat', sans-serif;
            font-weight: 400;
            display: inline-block;
            width: 60px;
        }

        @media (max-width: 768px) {
            .company-details {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .company-card {
                padding: 25px;
            }
        }
    </style>
</head>

