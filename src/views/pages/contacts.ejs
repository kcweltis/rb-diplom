<!doctype html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
        <%= title %>
    </title>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Philosopher:wght@400;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/contacts.css" />

    <script src="https://api-maps.yandex.ru/2.1/?lang=ru_RU" type="text/javascript"></script>

    <style>
        .address-list {
            list-style: none;
            padding: 0;
            margin: 0;
            max-height: 350px;
            overflow-y: auto;
            padding-right: 10px;
        }

        .address-list::-webkit-scrollbar {
            width: 6px;
        }

        .address-list::-webkit-scrollbar-thumb {
            background: rgba(227, 6, 19, 0.4);
            border-radius: 10px;
        }

        .address-list::-webkit-scrollbar-track {
            background: transparent;
        }

        .address-list li {
            position: relative;
            padding-left: 20px;
            margin-bottom: 12px;
            font-size: 14px;
            color: #333;
            line-height: 1.4;
        }

        .address-list li::before {
            content: '📍';
            position: absolute;
            left: 0;
            top: 0;
            font-size: 12px;
        }

        /* --- СТИЛИ ДЛЯ ПЛАШКИ УВЕДОМЛЕНИЯ --- */
        .toast-notification {
            visibility: hidden;
            min-width: 300px;
            background-color: #8CC63F;
            /* Зеленый цвет успеха */
            color: #fff;
            text-align: center;
            border-radius: 12px;
            padding: 16px 24px;
            position: fixed;
            z-index: 9999;
            left: 50%;
            bottom: -100px;
            /* Спрятано снизу */
            transform: translateX(-50%);
            box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.2);
            font-size: 15px;
            font-weight: 500;
            opacity: 0;
            transition: opacity 0.4s ease, bottom 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .toast-notification.show {
            visibility: visible;
            opacity: 1;
            bottom: 40px;
            /* Выезжает наверх */
        }
    </style>
</head>

<body>
    <%- include('../partials/header') %>

        <main class="page container">
            <h1 class="page-title" style="text-align: center;">Контакты</h1>

            <div class="tabs-container">
                <div class="toggle toggle--contacts">
                    <button class="toggle__btn is-active" type="button" data-tab="info">Адреса и контакты</button>
                    <button class="toggle__btn" type="button" data-tab="feedback">Отзыв</button>
                </div>
            </div>

            <section id="tab-info" class="tab-content is-active">
                <div class="contacts-grid">
                    <div class="contacts-info">
                        <h3>Единая справочная служба</h3>
                        <p class="contacts-phone" style="color: #E30613; font-weight: 800; font-size: 28px;">+7 (800)
                            500-80-05</p>
                        <p class="muted">Ежедневно с 10:00 до 22:00</p>

                        <h3 style="margin-top: 24px;">Электронная почта</h3>
                        <p>info@rusbliny.ru</p>

                        <h3 style="margin-top: 24px;">Наши рестораны в Оренбурге</h3>
                        <ul class="address-list">
                            <li>ул. Салмышская, 49</li>
                            <li>ул. Чкалова 26/1</li>
                            <li>ул. Володарского, 14</li>
                            <li>ул. Аксакова, 8</li>
                            <li>ул. Пролетарская, 294</li>
                            <li>пр-т Победы, 20</li>
                            <li>Загородное шоссе, 36/2 стр. 1</li>
                            <li>ул. 8 марта, д. 42 ТРЦ ВОСХОД</li>
                            <li>ул. Берёзовая Ростошь, 2а</li>
                            <li>ул. Новая, 4 ТРК Гулливер</li>
                            <li>Нежинское шоссе, 2а ТРЦ Армада 2</li>
                            <li>пр-т Дзержинского 23 ТРЦ Север</li>
                            <li>ул. Салмышская, 41 ТРЦ Новый Мир</li>
                            <li>ул. Беляевская, 19/1</li>
                            <li>Шарлыкское шоссе, 1/2 Мегамолл Мармелад</li>
                            <li>ул. Советская, 13</li>
                            <li>ул. Советская, 44</li>
                        </ul>
                    </div>

                    <div class="contacts-map">
                        <div id="map"
                            style="width: 100%; height: 100%; min-height: 500px; border-radius: var(--radius); overflow: hidden; background: #e9e9e9;">
                        </div>
                    </div>
                </div>
            </section>

            <section id="tab-feedback" class="tab-content" style="display: none;">
                <div class="feedback-wrapper">
                    <div class="feedback-header">
                        <h2 class="feedback-title">ВАШЕ МНЕНИЕ</h2>
                    </div>
                    <p class="feedback-desc">
                        Нам очень важна обратная связь от Вас, все жалобы/вопросы/предложения разбираются сотрудниками
                        компании, включая высшее руководство. Пожалуйста, заполните форму ниже.
                    </p>

                    <form class="form feedback-form" action="/api/feedback" method="POST" enctype="multipart/form-data">
                        <div class="form-group">
                            <label class="label">Тема обращения</label>
                            <select class="input" name="topic">
                                <option value="Благодарность">Благодарность</option>
                                <option value="Жалоба">Жалоба</option>
                                <option value="Вопрос">Вопрос</option>
                                <option value="Предложение">Предложение</option>
                            </select>
                        </div>

                        <div class="grid-2">
                            <div class="form-group">
                                <label class="label">Ваше имя <span style="color:red">*</span></label>
                                <input type="text" class="input" name="name" placeholder="Имя" required>
                            </div>
                            <div class="form-group">
                                <label class="label">Ваш email <span style="color:red">*</span></label>
                                <input type="email" class="input" name="email" placeholder="Email" required>
                            </div>
                        </div>

                        <div class="grid-2">
                            <div class="form-group">
                                <label class="label">Ваш телефон <span style="color:red">*</span></label>
                                <input type="tel" class="input" name="phone" placeholder="+7 (999) 999-99-99" required>
                            </div>
                            <div class="form-group" style="display: flex; align-items: flex-end;"></div>
                        </div>

                        <div class="form-group" style="margin-top: 20px;">
                            <label class="label">Ресторан <span style="color:red">*</span></label>
                            <select class="input" name="restaurant" required>
                                <option value="" disabled selected>Выберите ресторан...</option>
                                <option value="ул. Салмышская, 49">ул. Салмышская, 49</option>
                                <option value="ул. Чкалова 26/1">ул. Чкалова 26/1</option>
                                <option value="ул. Володарского, 14">ул. Володарского, 14</option>
                                <option value="ул. Аксакова, 8">ул. Аксакова, 8</option>
                                <option value="ул. Пролетарская, 294">ул. Пролетарская, 294</option>
                                <option value="пр-т Победы, 20">пр-т Победы, 20</option>
                                <option value="Загородное шоссе, 36/2 стр. 1">Загородное шоссе, 36/2 стр. 1</option>
                                <option value="ул. 8 марта, д. 42 ТРЦ ВОСХОД">ул. 8 марта, д. 42 ТРЦ ВОСХОД</option>
                                <option value="ул. Берёзовая Ростошь, 2а">ул. Берёзовая Ростошь, 2а</option>
                                <option value="ул. Новая, 4 ТРК Гулливер">ул. Новая, 4 ТРК Гулливер</option>
                                <option value="Нежинское шоссе, 2а ТРЦ Армада 2">Нежинское шоссе, 2а ТРЦ Армада 2
                                </option>
                                <option value="пр-т Дзержинского 23 ТРЦ Север">пр-т Дзержинского 23 ТРЦ Север</option>
                                <option value="ул. Салмышская, 41 ТРЦ Новый Мир">ул. Салмышская, 41 ТРЦ Новый Мир
                                </option>
                                <option value="ул. Беляевская, 19/1">ул. Беляевская, 19/1</option>
                                <option value="Шарлыкское шоссе, 1/2 Мегамолл Мармелад">Шарлыкское шоссе, 1/2 Мегамолл
                                    Мармелад</option>
                                <option value="ул. Советская, 13">ул. Советская, 13</option>
                                <option value="ул. Советская, 44">ул. Советская, 44</option>
                            </select>
                        </div>

                        <div class="grid-2">
                            <div class="form-group">
                                <label class="label">Дата посещения</label>
                                <input type="date" class="input" name="visit_date">
                            </div>
                            <div class="form-group">
                                <label class="label">Время посещения</label>
                                <input type="time" class="input" name="visit_time">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="label">Сообщение <span style="color:red">*</span></label>
                            <textarea class="input" name="message" rows="5" placeholder="Введите текст сообщения"
                                required></textarea>
                        </div>

                        <div class="file-upload">
                            <label class="btn btn--outline" id="fileLabel" style="cursor: pointer;">
                                📎 Прикрепить файл
                                <input type="file" name="file" id="fileInput" style="display: none;"
                                    accept=".doc,.pdf,.ppt,.docx,.pptx,.xls,.jpg,.png">
                            </label>
                            <span class="muted" style="font-size: 12px; margin-left: 10px;">.doc, .pdf, .jpg, .png до
                                10Мб</span>
                        </div>

                        <div class="form-group consent-group">
                            <label style="font-size: 12px; display: flex; gap: 8px; align-items: center;">
                                <input type="checkbox" required>
                                <span>Даю согласие на <a href="/consent"
                                        style="color: #E30613; text-decoration: underline;">обработку персональных
                                        данных</a> в соответствии с <a href="/privacy"
                                        style="color: #E30613; text-decoration: underline;">политикой
                                        конфиденциальности</a> сайта</span>
                            </label>
                        </div>

                        <div style="margin-top: 10px;">
                            <button type="submit" class="btn btn--primary">Отправить</button>
                            <p class="muted" style="font-size: 12px; margin-top: 8px;"><span style="color:red">*</span>
                                — Обязательно для заполнения</p>
                        </div>
                    </form>
                </div>
            </section>
        </main>

        <div id="feedbackToast" class="toast-notification">
            Спасибо! Ваше обращение отправлено.<br>Наш менеджер свяжется с вами в ближайшее время.
        </div>

        <%- include('../partials/footer') %>

            <script>
                const btns = document.querySelectorAll('.toggle--contacts .toggle__btn');
                const tabs = document.querySelectorAll('.tab-content');

                btns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        btns.forEach(b => b.classList.remove('is-active'));
                        tabs.forEach(t => t.style.display = 'none');
                        btn.classList.add('is-active');
                        document.getElementById('tab-' + btn.dataset.tab).style.display = 'block';
                    });
                });
            </script>

            <script>
                // --- 1. МАСКА ДЛЯ ТЕЛЕФОНА И ВАЛИДАЦИЯ ---
                const phoneInput = document.querySelector('input[name="phone"]');
                if (phoneInput) {
                    phoneInput.addEventListener('input', function (e) {
                        let input = e.target;
                        let value = input.value.replace(/\D/g, '');

                        if (!value) { input.value = ''; return; }

                        if (['7', '8', '9'].includes(value[0])) {
                            if (value[0] === '9') value = '7' + value;
                            let firstSymbols = (value[0] === '8') ? '8' : '+7';
                            let formatted = firstSymbols + ' ';

                            if (value.length > 1) formatted += '(' + value.substring(1, 4);
                            if (value.length >= 5) formatted += ') ' + value.substring(4, 7);
                            if (value.length >= 8) formatted += '-' + value.substring(7, 9);
                            if (value.length >= 10) formatted += '-' + value.substring(9, 11);

                            input.value = formatted;
                        } else {
                            input.value = '+' + value.substring(0, 15);
                        }
                    });
                }

                // --- 2. ОТОБРАЖЕНИЕ НАЗВАНИЯ ВЫБРАННОГО ФАЙЛА ---
                const fileInput = document.getElementById('fileInput');
                const fileLabel = document.getElementById('fileLabel');
                if (fileInput && fileLabel) {
                    fileInput.addEventListener('change', function () {
                        if (this.files && this.files.length > 0) {
                            // Если файл выбран, меняем текст на его название
                            fileLabel.innerHTML = '📎 ' + this.files[0].name;
                            fileLabel.style.borderColor = '#8CC63F'; // Подсвечиваем зеленым
                            fileLabel.style.color = '#8CC63F';
                        } else {
                            // Если файл отменен
                            fileLabel.innerHTML = '📎 Прикрепить файл';
                            fileLabel.style.borderColor = '';
                            fileLabel.style.color = '';
                        }
                    });
                }

                // --- 3. AJAX ОТПРАВКА ФОРМЫ (БЕЗ ПЕРЕЗАГРУЗКИ СТРАНИЦЫ) ---
                const feedbackForm = document.querySelector('.feedback-form');
                const toast = document.getElementById('feedbackToast');

                if (feedbackForm) {
                    feedbackForm.addEventListener('submit', async function (e) {
                        e.preventDefault(); // Останавливаем стандартную отправку

                        // Валидация телефона (должно быть 11 цифр)
                        const phoneVal = phoneInput.value.replace(/\D/g, '');
                        if (phoneVal.length !== 11) {
                            alert('Пожалуйста, введите корректный номер телефона (состоящий из 11 цифр)');
                            return;
                        }

                        // Меняем состояние кнопки на "Загрузка..."
                        const submitBtn = feedbackForm.querySelector('button[type="submit"]');
                        const originalText = submitBtn.innerText;
                        submitBtn.innerText = 'Отправляем...';
                        submitBtn.disabled = true;

                        try {
                            const formData = new FormData(feedbackForm);

                            const response = await fetch('/api/feedback', {
                                method: 'POST',
                                body: formData
                            });

                            if (response.ok) {
                                // Показываем нашу красивую плашку
                                toast.classList.add('show');

                                // Сбрасываем форму и кнопку файла
                                feedbackForm.reset();
                                if (fileLabel) {
                                    fileLabel.innerHTML = '📎 Прикрепить файл';
                                    fileLabel.style.borderColor = '';
                                    fileLabel.style.color = '';
                                }

                                // Прячем плашку через 5 секунд
                                setTimeout(() => {
                                    toast.classList.remove('show');
                                }, 5000);
                            } else {
                                alert('Произошла ошибка при отправке. Попробуйте позже.');
                            }
                        } catch (error) {
                            console.error(error);
                            alert('Ошибка сети. Проверьте подключение к интернету.');
                        } finally {
                            // Возвращаем кнопку в исходное состояние
                            submitBtn.innerText = originalText;
                            submitBtn.disabled = false;
                        }
                    });
                }
            </script>

            <script>
                ymaps.ready(initMap);

                function initMap() {
                    var myMap = new ymaps.Map("map", {
                        center: [51.768199, 55.096955],
                        zoom: 12,
                        controls: ['zoomControl', 'fullscreenControl']
                    });

                    var addresses = [
                        "Оренбург, ул. Салмышская, 49", "Оренбург, ул. Чкалова 26/1",
                        "Оренбург, ул. Володарского, 14", "Оренбург, ул. Аксакова, 8",
                        "Оренбург, ул. Пролетарская, 294", "Оренбург, пр-т Победы, 20",
                        "Оренбург, Загородное шоссе, 36/2", "Оренбург, ул. 8 марта, 42",
                        "Оренбург, ул. Берёзовая Ростошь, 2а", "Оренбург, ул. Новая, 4",
                        "Оренбург, Нежинское шоссе, 2а", "Оренбург, пр-т Дзержинского, 23",
                        "Оренбург, ул. Салмышская, 41", "Оренбург, ул. Беляевская, 19/1",
                        "Оренбург, Шарлыкское шоссе, 1/2", "Оренбург, ул. Советская, 13",
                        "Оренбург, ул. Советская, 44"
                    ];

                    addresses.forEach(function (address) {
                        ymaps.geocode(address, {
                            results: 1
                        }).then(function (res) {
                            var firstGeoObject = res.geoObjects.get(0);
                            if (firstGeoObject) {
                                var placemark = new ymaps.Placemark(firstGeoObject.geometry.getCoordinates(), {
                                    balloonContent: '<b>Русские Блины</b><br>' + address,
                                    hintContent: 'Русские Блины'
                                }, {
                                    preset: 'islands#redFoodIcon'
                                });
                                myMap.geoObjects.add(placemark);
                            }
                        });
                    });
                }
            </script>
</body>

</html>