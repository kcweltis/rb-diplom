<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f5f5f5;
            padding: 16px;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
        }

        .header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 16px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .header h1 {
            font-size: 20px;
            margin-bottom: 4px;
        }

        .order-details {
            display: none;
            background: white;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .order-details.active {
            display: block;
        }

        .order-details-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid #ecf0f1;
        }

        .order-details-back {
            color: #e74c3c;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
            border: none;
            background: none;
            font-size: 14px;
        }

        .order-details-info {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 16px;
        }

        .order-details-row {
            display: flex;
            gap: 12px;
            padding: 10px;
            background: #f9f9f9;
            border-radius: 8px;
        }

        .order-details-icon {
            font-size: 20px;
            flex-shrink: 0;
        }

        .order-details-content {
            flex: 1;
        }

        .order-details-label {
            font-size: 12px;
            color: #7f8c8d;
            margin-bottom: 4px;
        }

        .order-details-value {
            font-size: 14px;
            color: #2c3e50;
            font-weight: 600;
            word-break: break-word;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #e74c3c;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
        }

        .order-card {
            background: white;
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid #ecf0f1;
        }

        .order-id {
            font-weight: 600;
            color: #2c3e50;
        }

        .order-price {
            color: #e74c3c;
            font-weight: 600;
            font-size: 16px;
        }

        .order-info {
            font-size: 13px;
            color: #7f8c8d;
            margin-bottom: 8px;
        }

        .order-address {
            font-size: 13px;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .order-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
        }

        .order-time {
            color: #95a5a6;
        }

        .rating {
            color: #f39c12;
            font-weight: 600;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #7f8c8d;
        }

        .empty-icon {
            font-size: 48px;
            margin-bottom: 16px;
        }

        .btn {
            display: inline-block;
            padding: 12px 20px;
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 600;
            margin-top: 20px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn:active {
            transform: scale(0.98);
        }
    </style>
</head>

<body>
    <div class="container">
        <a href="/courier/dashboard" class="back-link">Назад</a>

        <div class="header">
            <h1>История доставок</h1>
        </div>

        <div class="order-details" id="orderDetails"></div>

        <% if (orders.length===0) { %>
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <p>Вы еще ничего не доставили</p>
            </div>
            <% } else { %>
                <div id="ordersList">
                <% orders.forEach(order=> { %>
                    <div class="order-card" onclick="showOrderDetails(<%= JSON.stringify({
                        id: order.id,
                        customer_name: order.customer_name,
                        customer_phone: order.customer_phone,
                        total_price: order.total_price,
                        delivered_at: order.delivered_at,
                        rating: order.rating,
                        comment: order.comment,
                        details: order.details
                    }).replace(/"/g, '&quot;') %>)">
                        <div class="order-header">
                            <span class="order-id">Заказ #<%= order.id %></span>
                            <span class="order-price">
                                <%= order.total_price %> ₽
                            </span>
                        </div>

                        <div class="order-address">
                            <% if (order.details) { %>
                                <% const details = typeof order.details === 'string' ? JSON.parse(order.details) : order.details; %>
                                <% if (details.address) { %>
                                    <%= details.address %><% if (details.apt) { %>, кв. <%= details.apt %><% } %>
                                <% } else { %>
                                    Адрес не указан
                                <% } %>
                            <% } else { %>
                                Адрес не указан
                            <% } %>
                        </div>

                        <div class="order-footer">
                            <span class="order-time">
                                <%= new Date(order.delivered_at).toLocaleString('ru-RU', { month: 'short' ,
                                    day: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %>
                            </span>
                            <% if (order.rating) { %>
                                <span class="rating">⭐ <%= order.rating %>/5</span>
                                <% } else { %>
                                    <span style="color: #95a5a6;">Нет оценки</span>
                                    <% } %>
                        </div>
                    </div>
                    <% }); %>
                </div>
                        <% } %>

            <button class="btn" onclick="returnToDashboard()">Вернуться</button>
    </div>

    <script>
        function showOrderDetails(orderData) {
            const detailsDiv = document.getElementById('orderDetails');
            const detailsHtml = `
                <div class="order-details-header">
                    <button class="order-details-back" onclick="hideOrderDetails()">Назад</button>
                    <span>Заказ #${orderData.id}</span>
                    <span></span>
                </div>
                <div class="order-details-info">
                    <div class="order-details-row">
                        <div class="order-details-icon">👤</div>
                        <div class="order-details-content">
                            <div class="order-details-label">Клиент</div>
                            <div class="order-details-value">${orderData.customer_name}</div>
                        </div>
                    </div>
                    <div class="order-details-row">
                        <div class="order-details-icon">📞</div>
                        <div class="order-details-content">
                            <div class="order-details-label">Телефон</div>
                            <a href="tel:${orderData.customer_phone}" class="order-details-value">${orderData.customer_phone}</a>
                        </div>
                    </div>
                    <div class="order-details-row">
                        <div class="order-details-icon">📍</div>
                        <div class="order-details-content">
                            <div class="order-details-label">Адрес доставки</div>
                            <div class="order-details-value">${(() => {
                                try {
                                    const details = typeof orderData.details === 'string' ? JSON.parse(orderData.details) : orderData.details;
                                    if (details && details.address) {
                                        let addr = details.address;
                                        if (details.apt) addr += ', кв. ' + details.apt;
                                        if (details.entrance) addr += ', подъезд ' + details.entrance;
                                        return addr;
                                    }
                                    return 'Адрес не указан';
                                } catch (e) {
                                    return 'Адрес не указан';
                                }
                            })()}</div>
                        </div>
                    </div>
                    <div class="order-details-row">
                        <div class="order-details-icon">💰</div>
                        <div class="order-details-content">
                            <div class="order-details-label">Сумма</div>
                            <div class="order-details-value">${orderData.total_price} ₽</div>
                        </div>
                    </div>
                    ${orderData.rating ? `
                    <div class="order-details-row">
                        <div class="order-details-icon">⭐</div>
                        <div class="order-details-content">
                            <div class="order-details-label">Оценка</div>
                            <div class="order-details-value">${orderData.rating}/5</div>
                        </div>
                    </div>
                    ${orderData.comment ? `
                    <div class="order-details-row">
                        <div class="order-details-icon">💬</div>
                        <div class="order-details-content">
                            <div class="order-details-label">Комментарий</div>
                            <div class="order-details-value">${orderData.comment}</div>
                        </div>
                    </div>
                    ` : ''}
                    ` : ''}
                </div>
            `;
            detailsDiv.innerHTML = detailsHtml;
            detailsDiv.classList.add('active');
            document.getElementById('ordersList').style.display = 'none';
        }

        function hideOrderDetails() {
            document.getElementById('orderDetails').classList.remove('active');
            document.getElementById('ordersList').style.display = 'block';
        }

        function returnToDashboard() {
            window.location.href = '/courier/dashboard';
        }
    </script>

</html>